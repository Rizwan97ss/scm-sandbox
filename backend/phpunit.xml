<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>/+
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <!-- Explicit, not inherited from .env's real value (https://sandbox.academia-erp.tech,
             correctly HTTPS in production). SecurityHeadersTest::test_hsts_is_not_sent_over_plain_http()
             relies on a relative URI resolving against a plain-http APP_URL to simulate an
             insecure request (its own sibling test's comment says as much) — without this
             override it inherits prod's https:// scheme, isSecure() is always true, and HSTS
             gets sent even where the test asserts it shouldn't be. -->
        <env name="APP_URL" value="http://localhost"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <!-- Explicit, not inherited from .env's real value (sandbox.academia-erp.tech
             only, correctly production-only — a dev-server hostname has no business
             being a trusted stateful origin in production). Tests\TestCase::setUp()
             sends every request with Referer: http://localhost:5173/ specifically so
             Sanctum's EnsureFrontendRequestsAreStateful recognizes it and attaches
             session middleware; without a matching entry here, that never happens and
             every test touching a session-based auth flow (login, MFA, logout) 500s
             with "Session store not set on request." Independent of prod's value on
             purpose — narrowing prod's stateful domains must never silently break the
             test suite's own separate needs. -->
        <env name="SANCTUM_STATEFUL_DOMAINS" value="localhost:5173"/>
        <!-- Explicitly blank, not inherited from .env's real value — StripeWebhookTest
             posts unsigned payloads, which only stays valid if VerifyWebhookSignature
             never attaches (see WebhookController::__construct). -->
        <env name="STRIPE_WEBHOOK_SECRET" value=""/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
